# Copy to .env for local runs. On a hosting platform, set these in its settings instead,
# and put OPENAI_API_KEY only in the platform's secret store.

# Model
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Disk cache for extraction results; the daily call counter lives in CACHE_DIR/usage/
CACHE_DIR=.cache/llm

# development | production (production turns off /docs, /redoc and /openapi.json)
ENVIRONMENT=development

# Match requests per client IP (0 turns a limit off)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=30

# Number of proxies in front of the app (Render, Hugging Face: 1). 0 ignores X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# Real model calls per UTC day for all clients together; cache hits are free
DAILY_MODEL_CALL_LIMIT=100

# CSP frame-ancestors: 'none' blocks framing; Hugging Face Spaces needs https://huggingface.co
FRAME_ANCESTORS='none'

# Optional: folder with the cv_*.txt / jd_*.txt samples shown in the page
# SAMPLES_DIR=data/synthetic
